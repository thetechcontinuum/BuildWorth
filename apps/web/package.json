{
  "name": "@buildworth/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "pnpm --filter @buildworth/shared --filter @buildworth/config --filter @buildworth/validation --filter @buildworth/observability --filter @buildworth/database --filter @buildworth/scoring --filter @buildworth/ui --filter @buildworth/ai --filter @buildworth/source-connectors --filter @buildworth/opportunity-engine run build && next build",
    "start": "next start -p 3000",
    "lint": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "db:generate": "pnpm --filter @buildworth/database run db:generate"
  },
  "dependencies": {
    "@buildworth/config": "workspace:*",
    "@buildworth/database": "workspace:*",
    "@buildworth/observability": "workspace:*",
    "@buildworth/scoring": "workspace:*",
    "@buildworth/shared": "workspace:*",
    "@buildworth/ui": "workspace:*",
    "@buildworth/validation": "workspace:*",
    "clsx": "^2.1.1",
    "lucide-react": "^0.395.0",
    "next": "^14.2.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.2"
  }
}
