generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.0.x", "darwin-arm64", "darwin"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  USER
  ADMIN
  REVIEWER
}

enum SubscriptionTier {
  FREE
  PRO
  TEAM
  ENTERPRISE
}

enum SignalType {
  PAIN
  WORKAROUND
  FEATURE_REQUEST
  PURCHASE_INTENT
  WILLINGNESS_TO_PAY
  COMPETITOR_COMPLAINT
  JOB_POSTING
  PROCUREMENT
  SEARCH_DEMAND
  PRICING
  TECHNOLOGY_ENABLER
  MARKET_ACTIVITY
  CONTRADICTING_EVIDENCE
  PAIN_COMPLAINT // Legacy compatibility
  WORKAROUND_REQUEST // Legacy compatibility
  COMPETITOR_DISSATISFACTION // Legacy compatibility
  EMERGING_TECH // Legacy compatibility
  NOISE
  PAIN_POINT // Legacy value
  FEATURE_REQUEST_LEGACY // Legacy value
  BUDGET_SIGNAL // Legacy value
  COMPETITOR_CHURN // Legacy value
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
  REJECTED
  STALE
  INACCESSIBLE
}

enum VerificationMethod {
  AUTOMATED_SOURCE_VALIDATION
  HUMAN_REVIEW
  TRUSTED_API
  IMPORTED_VERIFIED_DATASET
}

enum EvidenceOrigin {
  COLLECTED
  HUMAN_SUBMITTED
  IMPORTED
  SYNTHETIC_FIXTURE
  LEGACY_UNCLASSIFIED
}

enum SourceCredibilityTier {
  TIER_1_PRIMARY
  TIER_2_CREDIBLE_PUBLIC
  TIER_3_SECONDARY
}

enum SourcePolicyStatus {
  UNKNOWN
  REVIEW_REQUIRED
  ALLOWED
  ALLOWED_WITH_RESTRICTIONS
  BLOCKED
}

enum RelationshipType {
  SUPPORTS
  CONTRADICTS
}

enum SupportStrength {
  WEAK
  MODERATE
  STRONG
}

enum DatePrecision {
  EXACT_TIMESTAMP
  DAY
  MONTH
  UNKNOWN
}

enum PublicationQualityStatus {
  VERIFIED
  PARTIALLY_VERIFIED
  HYPOTHESIS
  EVIDENCE_PENDING
  STALE
}

enum ClaimType {
  PAIN_EXISTENCE
  PAIN_SEVERITY
  PAIN_FREQUENCY
  CURRENT_WORKAROUND
  BUYER_IDENTITY
  BUYER_DEMAND
  WILLINGNESS_TO_PAY
  MARKET_ATTRACTIVENESS
  COMPETITOR_GAP
  TECHNICAL_FEASIBILITY
  MVP_COST
  CUSTOMER_BENEFIT
  PLAUSIBLE_PRICING
  GO_TO_MARKET_ACCESSIBILITY
}

enum OpportunityStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum CustomerType {
  B2B
  B2C
  PROSUMER
  INTERNAL_TOOL
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
  OCCASIONAL
}

model User {
  id            String           @id @default(uuid())
  email         String           @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          Role             @default(USER)
  tier          SubscriptionTier @default(FREE)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  accounts           Account[]
  sessions           Session[]
  founderProfile     FounderProfile?
  savedOpportunities SavedOpportunity[]
  auditLogs          AuditLog[]
  scoreOverrides     ScoreOverride[]

  // Phase 4A Billing & Entitlements
  billingCustomer      BillingCustomer?
  billingSubscriptions BillingSubscription[]
  checkoutAttempts     BillingCheckoutAttempt[]
  entitlementGrants    EntitlementGrant[]
  usageLedgers         UsageLedger[]

  // Phase 4C Opportunity Radar & Notifications
  notificationPreference NotificationPreference?
  notificationOutbox     NotificationOutbox[]
  digestRuns             DigestRun[]
  unsubscribeTokens      NotificationUnsubscribeToken[]

  // Phase 4D Premium Content & Exports
  opportunityExports OpportunityExport[]
  commercialEvents   CommercialEvent[]
  consentHistories   AnalyticsConsentHistory[]

  @@map("users")
}

model Source {
  id                       String                 @id @default(uuid())
  key                      String                 @unique
  name                     String
  description              String
  sourceFamily             String?                @default("COMMUNITY")
  baseUrl                  String?
  adapterType              String
  accessMethod             String
  credibilityTier          SourceCredibilityTier?
  policyStatus             SourcePolicyStatus     @default(UNKNOWN)
  policyReviewedAt         DateTime?
  policyReviewedBy         String?
  policyNotes              String?
  rateLimitPerMinute       Int                    @default(60)
  isEnabled                Boolean                @default(true)
  termsNotes               String?
  attributionRequired      Boolean                @default(true)
  permittedExcerptLength   Int                    @default(280)
  storageRestrictions      String?
  lastSuccessfulCollection DateTime?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  runs            SourceRun[]
  rawSignals      RawSignal[]
  evidenceSignals NormalizedSignal[]

  @@map("sources")
}

model SourceRun {
  id              String    @id @default(uuid())
  sourceId        String
  source          Source    @relation(fields: [sourceId], references: [id])
  status          String // SUCCESS, FAILED, RUNNING
  signalsIngested Int       @default(0)
  errorMessage    String?
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?

  rawSignals RawSignal[]

  @@map("source_runs")
}

model RawSignal {
  id                String     @id @default(uuid())
  sourceId          String
  source            Source     @relation(fields: [sourceId], references: [id])
  sourceRunId       String?
  sourceRun         SourceRun? @relation(fields: [sourceRunId], references: [id])
  externalId        String
  sourceUrl         String
  authorFingerprint String?
  title             String?
  rawContent        String
  contentHash       String     @unique
  publishedAt       DateTime?
  createdAt         DateTime   @default(now())

  normalizedSignal NormalizedSignal?

  @@map("raw_signals")
}

model NormalizedSignal {
  id          String     @id @default(uuid())
  rawSignalId String?    @unique
  rawSignal   RawSignal? @relation(fields: [rawSignalId], references: [id])
  sourceId    String?
  source      Source?    @relation(fields: [sourceId], references: [id])

  signalType     SignalType      @default(PAIN)
  evidenceOrigin EvidenceOrigin? @default(LEGACY_UNCLASSIFIED)

  originalUrl  String?
  canonicalUrl String?
  sourceTitle  String?
  authorOrg    String?

  publishedAt          DateTime?
  publishedAtPrecision DatePrecision @default(UNKNOWN)
  collectedAt          DateTime      @default(now())
  language             String        @default("en")

  sanitizedExcerpt String
  problemSummary   String
  actorRole        String?
  workflowContext  String?

  severityScore     Int      @default(1)
  frequencyScore    Int      @default(1)
  intentToPayScore  Int      @default(0)
  extractedEntities String[] @default([])
  confidenceScore   Int      @default(0)

  purchaseIntent Boolean @default(false)
  spendingSignal String?
  desiredOutcome String?

  evidenceQuality            Float     @default(0.8)
  recencyScore               Float     @default(1.0)
  credibilityScore           Float     @default(0.8)
  contentFingerprint         String?
  duplicateGroupKey          String?
  independenceKey            String?
  independenceMethod         String?
  independenceConfidence     Float     @default(1.0)
  independenceOverride       String?
  independenceOverrideReason String?
  independenceOverriddenAt   DateTime?

  verificationStatus       VerificationStatus  @default(UNVERIFIED)
  verificationMethod       VerificationMethod?
  verifiedAt               DateTime?
  verifiedBy               String?
  verificationNotes        String?
  lastAccessibilityCheckAt DateTime?

  metadata    Json?
  isProcessed Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clusterMemberships ClusterMember[]
  evidenceLinks      EvidenceLink[]

  @@index([sourceId])
  @@index([publishedAt])
  @@index([verificationStatus])
  @@index([signalType])
  @@index([contentFingerprint])
  @@index([duplicateGroupKey])
  @@index([independenceKey])
  @@index([canonicalUrl])
  @@map("normalized_signals")
}

model ProblemCluster {
  id          String   @id @default(uuid())
  title       String
  summary     String
  signalCount Int      @default(0)
  vertical    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members       ClusterMember[]
  opportunities Opportunity[]

  @@map("problem_clusters")
}

model ClusterMember {
  id                 String           @id @default(uuid())
  clusterId          String
  cluster            ProblemCluster   @relation(fields: [clusterId], references: [id])
  normalizedSignalId String
  normalizedSignal   NormalizedSignal @relation(fields: [normalizedSignalId], references: [id])
  distanceScore      Float            @default(0.0)
  createdAt          DateTime         @default(now())

  @@unique([clusterId, normalizedSignalId])
  @@map("cluster_members")
}

model Opportunity {
  id                     String            @id @default(uuid())
  slug                   String            @unique
  title                  String
  oneSentenceSummary     String
  problemStatement       String
  jobsToBeDone           String[]
  proposedProduct        String
  narrowMvpScope         String[]
  targetCustomerSegments String[]
  economicBuyer          String
  endUser                String
  buyingTrigger          String
  existingWorkflow       String
  painSeverity           Severity
  painFrequency          Frequency
  status                 OpportunityStatus @default(DRAFT)
  customerType           CustomerType      @default(B2B)
  industry               String

  publicationQualityStatus PublicationQualityStatus @default(HYPOTHESIS)
  isDemoFixture            Boolean                  @default(false)
  currentRevisionId        String?                  @unique
  decisionRecommendation   DecisionRecommendation   @default(UNASSESSED)
  decisionReasonCodes      String[]                 @default([])
  primaryAdvantage         String?
  riskiestAssumption       String?
  cheapestExperiment       String?

  // Minor units (cents)
  estimatedMvpCostMinCents       Int
  estimatedMvpCostMaxCents       Int
  estimatedTimeToMvpMinWeeks     Int
  estimatedTimeToMvpMaxWeeks     Int
  estimatedMonthlyOpCostMinCents Int
  estimatedMonthlyOpCostMaxCents Int
  currency                       String @default("USD")

  recommendedNextExperiment String
  majorAssumptions          String[] @default([])
  majorRisks                String[] @default([])

  problemClusterId String?
  problemCluster   ProblemCluster? @relation(fields: [problemClusterId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scorecards         Scorecard[]
  evidenceLinks      EvidenceLink[]
  revisions          OpportunityRevision[]
  savedByUsers       SavedOpportunity[]
  scoreOverrides     ScoreOverride[]
  changeEvents       OpportunityChangeEvent[]
  notificationOutbox NotificationOutbox[]
  exports            OpportunityExport[]
  commercialEvents   CommercialEvent[]

  @@map("opportunities")
}

model OpportunityRevision {
  id              String      @id @default(uuid())
  opportunityId   String
  opportunity     Opportunity @relation(fields: [opportunityId], references: [id])
  revisionNumber  Int
  snapshotData    Json
  reasonForChange String
  createdAt       DateTime    @default(now())

  evidenceLinks        EvidenceLink[]
  blueprint            OpportunityBlueprint?
  FounderFitEvaluation FounderFitEvaluation[]

  changeEventsFrom   OpportunityChangeEvent[] @relation("FromRevision")
  changeEventsTo     OpportunityChangeEvent[] @relation("ToRevision")
  evaluatedInWatches SavedOpportunity[]       @relation("LastEvaluatedRevision")
  radarJob           OpportunityRadarJob?
  exports            OpportunityExport[]

  @@unique([opportunityId, revisionNumber])
  @@map("opportunity_revisions")
}

model EvidenceLink {
  id String @id @default(uuid())

  // Authoritative revision relation
  opportunityRevisionId String?
  opportunityRevision   OpportunityRevision? @relation(fields: [opportunityRevisionId], references: [id])

  // Legacy compatibility relation
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])

  normalizedSignalId String
  normalizedSignal   NormalizedSignal @relation(fields: [normalizedSignalId], references: [id])

  claimType       ClaimType @default(PAIN_EXISTENCE)
  claimIdentifier String    @default("pain_existence")
  claimSnippet    String

  relationshipType RelationshipType @default(SUPPORTS)
  supportStrength  SupportStrength  @default(MODERATE)
  explanation      String?
  relevanceScore   Float            @default(1.0)
  createdAt        DateTime         @default(now())

  segmentLinks    CustomerSegmentEvidenceLink[]
  competitorLinks CompetitorEvidenceLink[]
  costLinks       CostEvidenceLink[]
  benefitLinks    BenefitEvidenceLink[]
  riskLinks       RiskEvidenceLink[]
  assumptionLinks AssumptionEvidenceLink[]
  experimentLinks ExperimentEvidenceLink[]

  @@unique([opportunityRevisionId, normalizedSignalId, claimIdentifier, relationshipType])
  @@index([opportunityRevisionId])
  @@index([opportunityId])
  @@index([normalizedSignalId])
  @@index([claimIdentifier])
  @@index([relationshipType])
  @@map("evidence_links")
}

model Scorecard {
  id                      String      @id @default(uuid())
  opportunityId           String
  opportunity             Opportunity @relation(fields: [opportunityId], references: [id])
  opportunityScore        Int // 0 - 100
  evidenceConfidenceScore Int // 0 - 100
  demandScore             Int // 0 - 100
  feasibilityScore        Int // 0 - 100
  economicsScore          Int // 0 - 100
  competitionScore        Int // 0 - 100
  goMarketScore           Int // 0 - 100
  rubricVersion           String      @default("2.0.0")
  isHypothesisOnly        Boolean     @default(false)
  createdAt               DateTime    @default(now())

  dimensions ScoreDimension[]

  @@map("scorecards")
}

model ScoreDimension {
  id           String    @id @default(uuid())
  scorecardId  String
  scorecard    Scorecard @relation(fields: [scorecardId], references: [id])
  dimensionKey String
  name         String
  score        Int
  maxScore     Int
  explanation  String
  evidenceIds  String[]  @default([])
  assumptions  String[]  @default([])

  @@map("score_dimensions")
}

model ScoreOverride {
  id              String      @id @default(uuid())
  opportunityId   String
  opportunity     Opportunity @relation(fields: [opportunityId], references: [id])
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  dimensionKey    String
  originalScore   Int
  overriddenScore Int
  reason          String
  createdAt       DateTime    @default(now())

  @@map("score_overrides")
}

model SavedOpportunity {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  radarEnabled                Boolean              @default(true)
  alertCadence                RadarAlertCadence    @default(WEEKLY_DIGEST)
  minimumSeverity             RadarChangeSeverity  @default(MEDIUM)
  minimumConfidenceDelta      Int                  @default(5)
  alertOnStatusChange         Boolean              @default(true)
  alertOnRecommendationChange Boolean              @default(true)
  alertOnNewWtpEvidence       Boolean              @default(true)
  alertOnCostChange           Boolean              @default(true)
  alertOnCompetitorChange     Boolean              @default(true)
  alertOnRiskChange           Boolean              @default(true)
  mutedUntil                  DateTime?
  lastEvaluatedRevisionId     String?
  lastEvaluatedRevision       OpportunityRevision? @relation("LastEvaluatedRevision", fields: [lastEvaluatedRevisionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  radarEvaluations RadarEvaluation[]

  @@unique([userId, opportunityId])
  @@index([userId, radarEnabled])
  @@index([opportunityId, radarEnabled])
  @@map("saved_opportunities")
}

model AuditLog {
  id                      String   @id @default(uuid())
  userId                  String?
  user                    User?    @relation(fields: [userId], references: [id])
  action                  String // EVIDENCE_VERIFIED, CONFIDENCE_RECALCULATED, QUALITY_GATE_EVALUATED, etc.
  entityType              String // EVIDENCE_SIGNAL, OPPORTUNITY_REVISION, SCORECARD
  entityId                String
  evidenceId              String?
  opportunityRevisionId   String?
  previousState           String?
  newState                String?
  reason                  String?
  verificationMethod      String?
  confidenceRubricVersion String?
  publicationGateVersion  String?
  evidenceIdsUsed         String[] @default([])
  previousConfidence      Int?
  newConfidence           Int?
  details                 Json?
  ipAddress               String?
  createdAt               DateTime @default(now())

  @@index([entityType, entityId])
  @@index([evidenceId])
  @@index([opportunityRevisionId])
  @@map("audit_logs")
}

model AiSpendLedgerRecord {
  id               String   @id @default(uuid())
  model            String
  promptTokens     Int
  completionTokens Int
  costMinorUnits   Int // integer cents
  purpose          String
  createdAt        DateTime @default(now())

  @@map("ai_spend_ledger_records")
}

model KillSwitch {
  id        String   @id @default(uuid())
  subsystem String   @unique // e.g. "ALL", "AI_GENERATION", "INGESTION", "AUTO_PUBLISH"
  isActive  Boolean  @default(false)
  reason    String?
  updatedAt DateTime @updatedAt

  @@map("kill_switches")
}

enum DecisionRecommendation {
  BUILD_CANDIDATE
  VALIDATE_FIRST
  WATCH
  WEAK_OPPORTUNITY
  REJECT
  UNASSESSED
}

enum RiskCategory {
  MARKET
  BUYER
  COMPETITION
  TECHNICAL
  DATA
  SECURITY
  PRIVACY
  REGULATORY
  FINANCIAL
  DISTRIBUTION
  OPERATIONS
  DEPENDENCY
}

enum RiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskStatus {
  IDENTIFIED
  MITIGATING
  RESOLVED
  ACCEPTED
}

enum AssumptionCategory {
  PROBLEM
  BUYER
  WILLINGNESS_TO_PAY
  SOLUTION
  FEASIBILITY
  DISTRIBUTION
  COST
  REGULATORY
}

enum AssumptionStatus {
  UNTESTED
  TESTING
  SUPPORTED
  CONTRADICTED
  INVALIDATED
}

enum ExperimentType {
  CUSTOMER_INTERVIEW
  LANDING_PAGE
  WAITLIST
  PREORDER
  PAID_PILOT
  CONCIERGE_MVP
  PROTOTYPE_TEST
  PRICING_TEST
  CHANNEL_TEST
  TECHNICAL_SPIKE
}

enum ExperimentStatus {
  PLANNED
  RUNNING
  PASSED
  FAILED
  ABANDONED
}

enum SalesMotion {
  SELF_SERVICE
  PRODUCT_LED
  FOUNDER_LED
  SALES_ASSISTED
  ENTERPRISE_SALES
  PARTNER_LED
}

enum MvpCategory {
  MUST_HAVE
  SHOULD_HAVE
  LATER
  OUT_OF_SCOPE
}

enum ScenarioType {
  CONSERVATIVE
  BASE
  UPSIDE
}

enum CostType {
  ONE_TIME_BUILD
  MONTHLY_OPERATING
}

enum CostCategory {
  PRODUCT_DISCOVERY
  UX_UI_DESIGN
  FRONTEND_DEV
  BACKEND_DEV
  DATABASE_INFRA
  INTEGRATIONS
  AI_MODEL_WORK
  TESTING_QA
  SECURITY_COMPLIANCE
  DEPLOYMENT_DEVOPS
  CONTINGENCY
  HOSTING
  DATABASE
  STORAGE
  AI_APIS
  THIRD_PARTY_APIS
  EMAIL_NOTIFICATIONS
  OBSERVABILITY
  SUPPORT
  MAINTENANCE
  COMPLIANCE
  OTHER_VARIABLE
}

enum BenefitCategory {
  LABOR_TIME_SAVED
  AVOIDED_LOSSES
  AVOIDED_DOWNTIME
  REDUCED_SOFTWARE_SPEND
  INCREASED_REVENUE
  REDUCED_RISK
  FASTER_DELIVERY
  COMPLIANCE_SAVINGS
}

enum ProvenanceType {
  VERIFIED_EVIDENCE_BACKED
  PARTIALLY_EVIDENCE_BACKED
  ASSUMPTION
  MODEL_ESTIMATE
  LEGACY_UNCLASSIFIED
  SYNTHETIC_FIXTURE
  USER_PROVIDED
}

enum CalculationStatus {
  CALCULATED
  NOT_ENOUGH_DATA
  NOT_APPLICABLE
  INVALID_ASSUMPTION
  NEGATIVE_UNIT_ECONOMICS
}

model OpportunityBlueprint {
  id                    String              @id @default(uuid())
  opportunityRevisionId String              @unique
  opportunityRevision   OpportunityRevision @relation(fields: [opportunityRevisionId], references: [id], onDelete: Restrict)

  schemaVersion       String   @default("1.0.0")
  generationStatus    String   @default("SYNTHESIZED")
  generatedAt         DateTime @default(now())
  generatedBy         String?
  modelProvider       String?
  modelName           String?
  promptVersion       String?
  calculationVersion  String   @default("1.0.0")
  decisionRuleVersion String   @default("1.0.0")
  inputHash           String
  createdAt           DateTime @default(now())

  architectureSummary String?
  gtmNarrative        Json?
  first20Plan         Json?
  reachableMarket     Json?

  customerSegments      BlueprintCustomerSegment[]
  mvpFeatures           BlueprintMvpFeature[]
  founderRequirements   OpportunityFounderRequirements?
  founderFitEvaluations FounderFitEvaluation[]
  competitors           BlueprintCompetitor[]
  financialScenarios    FinancialScenario[]
  costLineItems         CostLineItem[]
  benefitDrivers        BenefitDriver[]
  risks                 BlueprintRisk[]
  assumptions           BlueprintAssumption[]
  validationExperiments ValidationExperiment[]
  decisionEvaluation    DecisionEvaluation?

  @@map("opportunity_blueprints")
}

model BlueprintCustomerSegment {
  id                    String               @id @default(uuid())
  blueprintId           String
  blueprint             OpportunityBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Restrict)
  segmentName           String
  industry              String
  companySizeRange      String
  geography             String
  businessModel         String
  endUserRole           String
  economicBuyerRole     String
  technicalApproverRole String?
  procurementComplexity String
  budgetCategory        String
  spendingBehavior      String
  buyingTrigger         String
  primaryObjection      String
  acquisitionChannels   String[]             @default([])
  salesCycleMinDays     Int
  salesCycleMaxDays     Int
  salesMotion           SalesMotion
  confidenceScore       Int
  provenanceType        ProvenanceType
  createdAt             DateTime             @default(now())

  evidenceLinks CustomerSegmentEvidenceLink[]

  @@map("blueprint_customer_segments")
}

model CustomerSegmentEvidenceLink {
  id                String                   @id @default(uuid())
  customerSegmentId String
  customerSegment   BlueprintCustomerSegment @relation(fields: [customerSegmentId], references: [id], onDelete: Cascade)
  evidenceLinkId    String
  evidenceLink      EvidenceLink             @relation(fields: [evidenceLinkId], references: [id], onDelete: Restrict)

  @@unique([customerSegmentId, evidenceLinkId])
  @@map("customer_segment_evidence_links")
}

model BlueprintMvpFeature {
  id                   String               @id @default(uuid())
  blueprintId          String
  blueprint            OpportunityBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Restrict)
  featureName          String
  description          String
  category             MvpCategory
  userJourneyStep      String?
  requiredIntegrations String[]             @default([])
  requiredData         String[]             @default([])
  dependencies         String[]             @default([])
  acceptanceCriteria   String[]             @default([])
  orderIndex           Int                  @default(0)
  createdAt            DateTime             @default(now())

  @@map("blueprint_mvp_features")
}

model BlueprintCompetitor {
  id                        String               @id @default(uuid())
  blueprintId               String
  blueprint                 OpportunityBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Restrict)
  name                      String
  competitorType            String
  knownPricing              String?
  strengths                 String[]             @default([])
  recurringComplaints       String[]             @default([])
  differentiationHypothesis String
  switchingCosts            String
  provenanceType            ProvenanceType
  createdAt                 DateTime             @default(now())

  evidenceLinks CompetitorEvidenceLink[]

  @@map("blueprint_competitors")
}

model CompetitorEvidenceLink {
  id             String              @id @default(uuid())
  competitorId   String
  competitor     BlueprintCompetitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  evidenceLinkId String
  evidenceLink   EvidenceLink        @relation(fields: [evidenceLinkId], references: [id], onDelete: Restrict)

  @@unique([competitorId, evidenceLinkId])
  @@map("competitor_evidence_links")
}

model FinancialScenario {
  id           String               @id @default(uuid())
  blueprintId  String
  blueprint    OpportunityBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Restrict)
  scenarioType ScenarioType
  currency     String               @default("USD")

  activeCustomers              Int
  monthlyPriceCents            Int
  onboardingPriceCents         Int @default(0)
  variableCostPerCustomerCents Int
  monthlyFixedCostCents        Int
  customerAcquisitionCostCents Int
  deliveryTimeWeeks            Int

  grossMarginPercent             Float?
  grossMarginStatus              CalculationStatus @default(CALCULATED)
  grossMarginReason              String?
  monthlyContributionMarginCents Int?
  monthlyOperatingProfitCents    Int?
  breakEvenCustomers             Int?
  breakEvenStatus                CalculationStatus @default(CALCULATED)
  breakEvenReason                String?
  customerAnnualCostCents        Int?
  customerAnnualBenefitCents     Int?
  customerNetAnnualBenefitCents  Int?
  customerRoiPercent             Float?
  customerRoiStatus              CalculationStatus @default(CALCULATED)
  customerRoiReason              String?
  customerPaybackMonths          Float?
  customerPaybackStatus          CalculationStatus @default(CALCULATED)
  customerPaybackReason          String?
  providerCacPaybackMonths       Float?
  providerCacPaybackStatus       CalculationStatus @default(CALCULATED)
  providerCacPaybackReason       String?

  provenanceType ProvenanceType
  assumptions    String[]       @default([])
  inputHash      String
  calculatedAt   DateTime       @default(now())

  @@unique([blueprintId, scenarioType])
  @@map("financial_scenarios")
}

model CostLineItem {
  id               String               @id @default(uuid())
  blueprintId      String
  blueprint        OpportunityBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Restrict)
  costType         CostType
  category         CostCategory
  title            String
  description      String?
  scenarioType     ScenarioType         @default(BASE)
  amountMinorCents Int
  currency         String               @default("USD")
  estimateMethod   String
  provenanceType   ProvenanceType
  confidenceScore  Int
  createdAt        DateTime             @default(now())

  evidenceLinks CostEvidenceLink[]
  assumptions   CostAssumptionLink[]

  @@map("cost_line_items")
}

model CostEvidenceLink {
  id             String       @id @default(uuid())
  costLineItemId String
  costLineItem   CostLineItem @relation(fields: [costLineItemId], references: [id], onDelete: Cascade)
  evidenceLinkId String
  evidenceLink   EvidenceLink @relation(fields: [evidenceLinkId], references: [id], onDelete: Restrict)

  @@unique([costLineItemId, evidenceLinkId])
  @@map("cost_evidence_links")
}

model CostAssumptionLink {
  id             String              @id @default(uuid())
  costLineItemId String
  costLineItem   CostLineItem        @relation(fields: [costLineItemId], references: [id], onDelete: Cascade)
  assumptionId   String
  assumption     BlueprintAssumption @relation(fields: [assumptionId], references: [id], onDelete: Restrict)

  @@unique([costLineItemId, assumptionId])
  @@map("cost_assumption_links")
}

model BenefitDriver {
  id                     String               @id @default(uuid())
  blueprintId            String
  blueprint              OpportunityBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Restrict)
  category               BenefitCategory
  title                  String
  affectedRole           String
  unitQuantity           Float
  unitValueCents         Int
  frequencyPeriod        String
  annualValueCents       Int
  calculationDescription String
  provenanceType         ProvenanceType
  confidenceScore        Int
  createdAt              DateTime             @default(now())

  evidenceLinks BenefitEvidenceLink[]
  assumptions   BenefitAssumptionLink[]

  @@map("benefit_drivers")
}

model BenefitEvidenceLink {
  id              String        @id @default(uuid())
  benefitDriverId String
  benefitDriver   BenefitDriver @relation(fields: [benefitDriverId], references: [id], onDelete: Cascade)
  evidenceLinkId  String
  evidenceLink    EvidenceLink  @relation(fields: [evidenceLinkId], references: [id], onDelete: Restrict)

  @@unique([benefitDriverId, evidenceLinkId])
  @@map("benefit_evidence_links")
}

model BenefitAssumptionLink {
  id              String              @id @default(uuid())
  benefitDriverId String
  benefitDriver   BenefitDriver       @relation(fields: [benefitDriverId], references: [id], onDelete: Cascade)
  assumptionId    String
  assumption      BlueprintAssumption @relation(fields: [assumptionId], references: [id], onDelete: Restrict)

  @@unique([benefitDriverId, assumptionId])
  @@map("benefit_assumption_links")
}

model BlueprintRisk {
  id                    String               @id @default(uuid())
  blueprintId           String
  blueprint             OpportunityBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Restrict)
  category              RiskCategory
  description           String
  probabilityScore      Int
  impactScore           Int
  severity              RiskSeverity
  mitigationStrategy    String
  earlyWarningIndicator String?
  status                RiskStatus           @default(IDENTIFIED)
  provenanceType        ProvenanceType
  createdAt             DateTime             @default(now())

  evidenceLinks RiskEvidenceLink[]

  @@map("blueprint_risks")
}

model RiskEvidenceLink {
  id             String        @id @default(uuid())
  riskId         String
  risk           BlueprintRisk @relation(fields: [riskId], references: [id], onDelete: Cascade)
  evidenceLinkId String
  evidenceLink   EvidenceLink  @relation(fields: [evidenceLinkId], references: [id], onDelete: Restrict)

  @@unique([riskId, evidenceLinkId])
  @@map("risk_evidence_links")
}

model BlueprintAssumption {
  id               String               @id @default(uuid())
  blueprintId      String
  blueprint        OpportunityBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Restrict)
  statement        String
  category         AssumptionCategory
  importanceScore  Int
  uncertaintyScore Int
  testMethod       String
  successThreshold String
  failureThreshold String
  status           AssumptionStatus     @default(UNTESTED)
  provenanceType   ProvenanceType       @default(ASSUMPTION)
  createdAt        DateTime             @default(now())

  evidenceLinks AssumptionEvidenceLink[]
  costLinks     CostAssumptionLink[]
  benefitLinks  BenefitAssumptionLink[]

  @@map("blueprint_assumptions")
}

model AssumptionEvidenceLink {
  id             String              @id @default(uuid())
  assumptionId   String
  assumption     BlueprintAssumption @relation(fields: [assumptionId], references: [id], onDelete: Cascade)
  evidenceLinkId String
  evidenceLink   EvidenceLink        @relation(fields: [evidenceLinkId], references: [id], onDelete: Restrict)

  @@unique([assumptionId, evidenceLinkId])
  @@map("assumption_evidence_links")
}

model ValidationExperiment {
  id                    String               @id @default(uuid())
  blueprintId           String
  blueprint             OpportunityBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Restrict)
  hypothesis            String
  experimentType        ExperimentType
  targetParticipant     String
  sampleSize            Int
  estimatedCostCents    Int
  estimatedDurationDays Int
  acquisitionChannel    String
  procedureSummary      String
  successMetric         String
  successThreshold      String
  failureThreshold      String
  killCriterion         String
  nextActionOnSuccess   String
  nextActionOnFailure   String
  status                ExperimentStatus     @default(PLANNED)
  orderPriority         Int                  @default(0)
  createdAt             DateTime             @default(now())

  evidenceGenerated ExperimentEvidenceLink[]

  @@map("validation_experiments")
}

model ExperimentEvidenceLink {
  id             String               @id @default(uuid())
  experimentId   String
  experiment     ValidationExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  evidenceLinkId String
  evidenceLink   EvidenceLink         @relation(fields: [evidenceLinkId], references: [id], onDelete: Restrict)

  @@unique([experimentId, evidenceLinkId])
  @@map("experiment_evidence_links")
}

model DecisionEvaluation {
  id                       String                   @id @default(uuid())
  blueprintId              String                   @unique
  blueprint                OpportunityBlueprint     @relation(fields: [blueprintId], references: [id], onDelete: Restrict)
  recommendation           DecisionRecommendation   @default(UNASSESSED)
  reasonCodes              String[]                 @default([])
  blockingConditions       String[]                 @default([])
  opportunityScoreUsed     Int
  evidenceConfidenceUsed   Int
  publicationStatusUsed    PublicationQualityStatus
  economicsStatus          String
  feasibilityStatus        String
  criticalRiskIds          String[]                 @default([])
  invalidatedAssumptionIds String[]                 @default([])
  decisionRuleVersion      String                   @default("1.0.0")
  inputHash                String
  evaluatedAt              DateTime                 @default(now())

  @@map("decision_evaluations")
}

// ==========================================
// PHASE 3: AUTHENTICATION & FOUNDER FIT
// ==========================================

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ------------------------------------------
// Relational Skill Taxonomy
// ------------------------------------------

model SkillTaxonomyVersion {
  id          String   @id @default(uuid())
  version     String   @unique // e.g. "1.0.0"
  description String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  skills SkillDefinition[]

  @@map("skill_taxonomy_versions")
}

model SkillDefinition {
  id          String               @id @default(uuid())
  taxonomyId  String
  taxonomy    SkillTaxonomyVersion @relation(fields: [taxonomyId], references: [id], onDelete: Restrict)
  key         String               @unique // e.g. "TYPESCRIPT", "B2B_SALES"
  displayName String
  category    String // ENGINEERING, PRODUCT, SALES, MARKETING, DESIGN, OPERATIONS, COMPLIANCE
  description String
  isActive    Boolean              @default(true)
  parentKey   String?
  createdAt   DateTime             @default(now())

  aliases       SkillAlias[]
  founderSkills FounderSkill[]
  requiredBy    OpportunityRequiredSkill[]

  @@map("skill_definitions")
}

model SkillAlias {
  id        String          @id @default(uuid())
  skillId   String
  skill     SkillDefinition @relation(fields: [skillId], references: [id], onDelete: Cascade)
  alias     String          @unique // e.g. "ts", "react.js"
  createdAt DateTime        @default(now())

  @@map("skill_aliases")
}

// ------------------------------------------
// Versioned Founder Profile
// ------------------------------------------

enum ProficiencyLevel {
  NONE
  BASIC
  WORKING
  ADVANCED
  EXPERT
}

enum BudgetBand {
  UNDER_1K_USD
  USD_1K_TO_5K
  USD_5K_TO_20K
  USD_20K_TO_50K
  USD_50K_PLUS
}

enum CapacityBand {
  UNDER_10_HOURS
  HOURS_10_TO_20
  HOURS_21_TO_35
  HOURS_36_TO_40
  OVER_40_HOURS
}

enum TeamSizeBand {
  SOLO_FOUNDER
  FOUNDER_PLUS_CONTRACTORS
  SMALL_TEAM_2_TO_3
  CORE_TEAM_4_PLUS
}

enum RiskToleranceLevel {
  LOW
  MEDIUM
  HIGH
}

enum FundingPreference {
  BOOTSTRAP_ONLY
  BOOTSTRAP_FIRST
  OPEN_TO_FUNDING
  VENTURE_SCALE
}

enum FitRecommendationCategory {
  EXCELLENT_MATCH
  STRONG_MATCH
  POSSIBLE_MATCH
  CHALLENGING_MATCH
  POOR_MATCH
  INSUFFICIENT_PROFILE_DATA
}

enum HardBlockerCode {
  BUDGET_BELOW_MINIMUM
  REQUIRED_SKILL_MISSING
  CAPACITY_INSUFFICIENT
  TEAM_SIZE_INSUFFICIENT
  REGULATORY_RISK_REJECTED
  TARGET_GEOGRAPHY_INACCESSIBLE
  SALES_COMPLEXITY_REJECTED
  REQUIRED_DATA_ACCESS_MISSING
  FUNDING_MODEL_INCOMPATIBLE
  SUPPORT_BURDEN_INCOMPATIBLE
}

model FounderProfile {
  id                       String   @id @default(uuid())
  userId                   String   @unique
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentProfileRevisionId String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  revisions FounderProfileRevision[]

  @@map("founder_profiles")
}

model FounderProfileRevision {
  id             String         @id @default(uuid())
  profileId      String
  profile        FounderProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  revisionNumber Int
  schemaVersion  String         @default("1.0.0")
  inputHash      String
  createdAt      DateTime       @default(now())

  skills             FounderSkill[]
  domainExpertise    FounderDomainExpertise[]
  distributionAssets FounderDistributionAsset[]
  preference         FounderPreference?
  constraint         FounderConstraint?
  fitEvaluations     FounderFitEvaluation[]
  radarEvaluations   RadarEvaluation[]

  @@unique([profileId, revisionNumber])
  @@map("founder_profile_revisions")
}

model FounderSkill {
  id                String                 @id @default(uuid())
  profileRevisionId String
  profileRevision   FounderProfileRevision @relation(fields: [profileRevisionId], references: [id], onDelete: Cascade)
  skillKey          String
  skillDefinition   SkillDefinition        @relation(fields: [skillKey], references: [key], onDelete: Restrict)
  proficiency       ProficiencyLevel
  isPrimary         Boolean                @default(false)
  createdAt         DateTime               @default(now())

  @@unique([profileRevisionId, skillKey])
  @@map("founder_skills")
}

model FounderDomainExpertise {
  id                  String                 @id @default(uuid())
  profileRevisionId   String
  profileRevision     FounderProfileRevision @relation(fields: [profileRevisionId], references: [id], onDelete: Cascade)
  industryOrDomain    String
  yearsExperienceBand String
  workflowContext     String?
  createdAt           DateTime               @default(now())

  @@map("founder_domain_expertise")
}

model FounderDistributionAsset {
  id                String                 @id @default(uuid())
  profileRevisionId String
  profileRevision   FounderProfileRevision @relation(fields: [profileRevisionId], references: [id], onDelete: Cascade)
  assetType         String
  audienceSizeBand  String?
  description       String
  createdAt         DateTime               @default(now())

  @@map("founder_distribution_assets")
}

model FounderPreference {
  id                      String                 @id @default(uuid())
  profileRevisionId       String                 @unique
  profileRevision         FounderProfileRevision @relation(fields: [profileRevisionId], references: [id], onDelete: Cascade)
  preferredIndustries     String[]               @default([])
  excludedIndustries      String[]               @default([])
  preferredBusinessModels String[]               @default([])
  targetGeographies       String[]               @default([])
  preferredBuyerRoles     String[]               @default([])
  preferredSalesMotion    String?
  createdAt               DateTime               @default(now())

  @@map("founder_preferences")
}

model FounderConstraint {
  id                         String                 @id @default(uuid())
  profileRevisionId          String                 @unique
  profileRevision            FounderProfileRevision @relation(fields: [profileRevisionId], references: [id], onDelete: Cascade)
  mvpBudgetBand              BudgetBand             @default(UNDER_1K_USD)
  budgetCurrency             String                 @default("USD")
  availableHoursPerWeekBand  CapacityBand           @default(HOURS_10_TO_20)
  teamSizeBand               TeamSizeBand           @default(SOLO_FOUNDER)
  maxTimeToMvpWeeks          Int?
  technicalRiskTolerance     RiskToleranceLevel     @default(MEDIUM)
  regulatoryRiskTolerance    RiskToleranceLevel     @default(LOW)
  salesComplexityTolerance   RiskToleranceLevel     @default(LOW)
  operationalBurdenTolerance RiskToleranceLevel     @default(MEDIUM)
  fundingPreference          FundingPreference      @default(BOOTSTRAP_ONLY)
  createdAt                  DateTime               @default(now())

  @@map("founder_constraints")
}

// ------------------------------------------
// Revision-Owned Opportunity Requirements
// ------------------------------------------

model OpportunityFounderRequirements {
  id          String               @id @default(uuid())
  blueprintId String               @unique
  blueprint   OpportunityBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Restrict)

  schemaVersion                String             @default("1.0.0")
  minimumBudgetBand            BudgetBand         @default(UNDER_1K_USD)
  minimumCapacityBand          CapacityBand       @default(HOURS_10_TO_20)
  minimumTeamSizeBand          TeamSizeBand       @default(SOLO_FOUNDER)
  maxExpectedDeliveryWeeks     Int                @default(4)
  requiredTechnicalRiskLevel   RiskToleranceLevel @default(MEDIUM)
  requiredRegulatoryRiskLevel  RiskToleranceLevel @default(LOW)
  requiredSalesComplexityLevel RiskToleranceLevel @default(LOW)
  targetBuyerRoles             String[]           @default([])
  targetIndustries             String[]           @default([])
  targetGeographies            String[]           @default([])
  createdAt                    DateTime           @default(now())

  requiredSkills        OpportunityRequiredSkill[]
  founderFitEvaluations FounderFitEvaluation[]

  @@map("opportunity_founder_requirements")
}

model OpportunityRequiredSkill {
  id                   String                         @id @default(uuid())
  requirementsId       String
  requirements         OpportunityFounderRequirements @relation(fields: [requirementsId], references: [id], onDelete: Cascade)
  skillKey             String
  skillDefinition      SkillDefinition                @relation(fields: [skillKey], references: [key], onDelete: Restrict)
  minimumProficiency   ProficiencyLevel               @default(BASIC)
  preferredProficiency ProficiencyLevel               @default(WORKING)
  importance           Int                            @default(3) // 1-5
  isOutsourceable      Boolean                        @default(true)
  createdAt            DateTime                       @default(now())

  @@unique([requirementsId, skillKey])
  @@map("opportunity_required_skills")
}

// ------------------------------------------
// Deterministic Founder Fit Evaluations
// ------------------------------------------

model FounderFitEvaluation {
  id                    String                         @id @default(uuid())
  userId                String
  profileRevisionId     String
  profileRevision       FounderProfileRevision         @relation(fields: [profileRevisionId], references: [id], onDelete: Restrict)
  opportunityRevisionId String
  opportunityRevision   OpportunityRevision            @relation(fields: [opportunityRevisionId], references: [id], onDelete: Restrict)
  blueprintId           String
  blueprint             OpportunityBlueprint           @relation(fields: [blueprintId], references: [id], onDelete: Restrict)
  requirementsId        String
  requirements          OpportunityFounderRequirements @relation(fields: [requirementsId], references: [id], onDelete: Restrict)

  founderFitScore        Int // 0-100
  fitConfidence          Int // 0-100
  recommendationCategory FitRecommendationCategory
  personalizedRank       Float
  baseRank               Float
  totalPenaltyPoints     Int                       @default(0)
  rubricVersion          String                    @default("1.0.0")
  rankingVersion         String                    @default("1.0.0")
  taxonomyVersion        String                    @default("1.0.0")
  inputHash              String
  calculatedAt           DateTime                  @default(now())

  dimensions FounderFitDimension[]
  blockers   FounderFitBlocker[]
  strengths  FounderFitStrength[]
  gaps       FounderFitGap[]

  @@unique([profileRevisionId, opportunityRevisionId, rubricVersion, rankingVersion])
  @@map("founder_fit_evaluations")
}

model FounderFitDimension {
  id                  String               @id @default(uuid())
  evaluationId        String
  evaluation          FounderFitEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  dimensionName       String
  score               Int
  maxScore            Int
  status              String
  explanation         String
  matchedRequirements String[]             @default([])
  missingRequirements String[]             @default([])
  createdAt           DateTime             @default(now())

  @@map("founder_fit_dimensions")
}

model FounderFitBlocker {
  id                  String               @id @default(uuid())
  evaluationId        String
  evaluation          FounderFitEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  blockerCode         HardBlockerCode
  severity            String
  explanation         String
  sourceRequirement   String
  profileConstraint   String
  isRemovable         Boolean              @default(false)
  suggestedMitigation String?
  createdAt           DateTime             @default(now())

  @@map("founder_fit_blockers")
}

model FounderFitStrength {
  id           String               @id @default(uuid())
  evaluationId String
  evaluation   FounderFitEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  title        String
  description  String
  category     String
  createdAt    DateTime             @default(now())

  @@map("founder_fit_strengths")
}

model FounderFitGap {
  id                   String               @id @default(uuid())
  evaluationId         String
  evaluation           FounderFitEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  title                String
  description          String
  severity             String
  mitigationSuggestion String
  createdAt            DateTime             @default(now())

  @@map("founder_fit_gaps")
}

model RateLimitBucket {
  id        String   @id @default(uuid())
  key       String   @unique // Hashed IP, email, or user identifier
  points    Int      @default(0)
  expireAt  DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expireAt])
  @@map("rate_limit_buckets")
}

// ==========================================
// PHASE 4A: BILLING & ENTITLEMENTS FOUNDATION
// ==========================================

enum BillingSubscriptionStatus {
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  PAUSED
  UNKNOWN
}

enum EntitlementType {
  EVIDENCE_LINEAGE_UNRESTRICTED
  FOUNDER_FIT_FULL_BREAKDOWN
  VENTURE_BLUEPRINT_FINANCIALS
  VENTURE_BLUEPRINT_EXPORT
  OPPORTUNITY_RADAR_WATCHLIST
  OPPORTUNITY_RADAR_ALERTS
  OPPORTUNITY_COMPARISON
  EARLY_OPPORTUNITY_ACCESS
  CUSTOM_SOURCE_INDEXING
}

enum EntitlementGrantSource {
  SUBSCRIPTION
  PROMOTIONAL
  ADMIN_OVERRIDE
  TRIAL
}

model ProductPlan {
  id          String   @id @default(uuid())
  code        String   @unique // FREE, PRO, TEAM, ENTERPRISE
  name        String
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  prices       PlanPrice[]
  entitlements PlanEntitlement[]

  @@map("product_plans")
}

model PlanPrice {
  id              String      @id @default(uuid())
  planId          String
  plan            ProductPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  stripePriceId   String?     @unique
  billingInterval String // MONTHLY, ANNUAL, LIFETIME, ONE_OFF
  currency        String      @default("USD")
  amountCents     Int
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  subscriptions BillingSubscription[]

  @@map("plan_prices")
}

model PlanEntitlement {
  id              String          @id @default(uuid())
  planId          String
  plan            ProductPlan     @relation(fields: [planId], references: [id], onDelete: Restrict)
  entitlementType EntitlementType
  isUnlimited     Boolean         @default(false)
  limitQuantity   Int? // e.g. 50 saved opportunities, 10 daily searches
  resetInterval   String? // DAILY, MONTHLY, NEVER
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([planId, entitlementType])
  @@map("plan_entitlements")
}

model BillingCustomer {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId String   @unique
  billingEmail     String?
  currency         String   @default("USD")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  subscriptions BillingSubscription[]

  @@map("billing_customers")
}

model BillingSubscription {
  id                           String                    @id @default(uuid())
  userId                       String
  user                         User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  billingCustomerId            String
  billingCustomer              BillingCustomer           @relation(fields: [billingCustomerId], references: [id], onDelete: Restrict)
  planPriceId                  String
  planPrice                    PlanPrice                 @relation(fields: [planPriceId], references: [id], onDelete: Restrict)
  stripeSubscriptionId         String?                   @unique
  status                       BillingSubscriptionStatus
  currentPeriodStart           DateTime
  currentPeriodEnd             DateTime
  cancelAtPeriodEnd            Boolean                   @default(false)
  canceledAt                   DateTime?
  trialStart                   DateTime?
  trialEnd                     DateTime?
  latestProviderEventTimestamp DateTime?
  createdAt                    DateTime                  @default(now())
  updatedAt                    DateTime                  @updatedAt

  entitlementGrants EntitlementGrant[]

  @@index([userId, status])
  @@map("billing_subscriptions")
}

model BillingWebhookEvent {
  id               String    @id @default(uuid())
  eventId          String    @unique // Stripe Event ID
  eventType        String // e.g. customer.subscription.updated
  idempotencyKey   String?   @unique
  payloadHash      String? // SHA-256 hash of raw payload
  payload          Json
  processedAt      DateTime?
  processingStatus String    @default("PENDING") // PENDING, PROCESSED, FAILED, IGNORED
  errorMessage     String?
  attemptCount     Int       @default(0)
  createdAt        DateTime  @default(now())

  @@map("billing_webhook_events")
}

model BillingCheckoutAttempt {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestId         String    @unique
  selectedPlanCode  String // "PRO"
  billingInterval   String // "MONTHLY" | "ANNUAL"
  planPriceId       String
  stripePriceId     String
  checkoutSessionId String?   @unique
  idempotencyKey    String    @unique
  status            String    @default("PENDING") // PENDING, COMPLETED, EXPIRED, FAILED
  completedAt       DateTime?
  expiresAt         DateTime
  createdAt         DateTime  @default(now())

  commercialEvents CommercialEvent[]

  @@index([userId, status])
  @@map("billing_checkout_attempts")
}

model EntitlementGrant {
  id              String                 @id @default(uuid())
  userId          String
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId  String?
  subscription    BillingSubscription?   @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  entitlementType EntitlementType
  source          EntitlementGrantSource @default(SUBSCRIPTION)
  isUnlimited     Boolean                @default(false)
  limitQuantity   Int?
  remainingUnits  Int?
  startsAt        DateTime               @default(now())
  expiresAt       DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@unique([userId, entitlementType, source])
  @@map("entitlement_grants")
}

model UsageLedger {
  id              String          @id @default(uuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  entitlementType EntitlementType
  unitsConsumed   Int             @default(1)
  resourceId      String? // e.g. opportunityId, blueprintId
  actionContext   String? // e.g. "EXPORT_PDF", "RADAR_WATCHLIST_ADD"
  idempotencyKey  String?         @unique // Deterministic idempotency key
  periodBucketKey String // e.g. "2026-08", "2026-08-25"
  createdAt       DateTime        @default(now())

  reservedExports OpportunityExport[] @relation("ExportReservation")
  consumedExports OpportunityExport[] @relation("ExportConsumption")
  releasedExports OpportunityExport[] @relation("ExportRelease")

  @@index([userId, entitlementType, periodBucketKey])
  @@map("usage_ledgers")
}

// ====================================================
// PHASE 4C: OPPORTUNITY RADAR & NOTIFICATION OUTBOX
// ====================================================

enum RadarChangeDimension {
  PUBLICATION_STATUS
  EVIDENCE_CONFIDENCE
  DECISION_RECOMMENDATION
  WILLINGNESS_TO_PAY
  PRICING
  MVP_COST
  DELIVERY_TIME
  COMPETITOR
  CRITICAL_RISK
  EVIDENCE_SIGNAL
}

enum RadarChangeDirection {
  POSITIVE
  NEGATIVE
  NEUTRAL
}

enum RadarChangeSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RadarAlertCadence {
  INSTANT
  DAILY_DIGEST
  WEEKLY_DIGEST
}

enum NotificationChannel {
  EMAIL
  IN_APP
}

enum RadarJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  DEAD_LETTER
}

enum OutboxNotificationType {
  RADAR_CHANGE_ALERT
  RADAR_DAILY_DIGEST
  RADAR_WEEKLY_DIGEST
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  DEAD_LETTER
  SKIPPED
  CANCELLED
}

enum DeliveryProvider {
  SMTP
  RESEND
  TEST_MOCK
}

enum DeliveryStatus {
  SUCCESS
  FAILED
  PENDING
}

model OpportunityRadarJob {
  id                    String              @id @default(uuid())
  opportunityRevisionId String              @unique
  opportunityRevision   OpportunityRevision @relation(fields: [opportunityRevisionId], references: [id], onDelete: Cascade)
  status                RadarJobStatus      @default(PENDING)
  claimToken            String?
  lockedBy              String?
  lockedAt              DateTime?
  lockedUntil           DateTime?
  attemptCount          Int                 @default(0)
  nextAttemptAt         DateTime?
  lastError             String?
  completedAt           DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([status, nextAttemptAt])
  @@index([status, lockedUntil])
  @@map("opportunity_radar_jobs")
}

model OpportunityChangeEvent {
  id                 String              @id @default(uuid())
  opportunityId      String
  opportunity        Opportunity         @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  fromRevisionId     String
  fromRevision       OpportunityRevision @relation("FromRevision", fields: [fromRevisionId], references: [id], onDelete: Cascade)
  toRevisionId       String
  toRevision         OpportunityRevision @relation("ToRevision", fields: [toRevisionId], references: [id], onDelete: Cascade)
  diffVersion        String              @default("1.0.0")
  canonicalInputHash String
  overallSeverity    RadarChangeSeverity @default(LOW)
  createdAt          DateTime            @default(now())

  items              OpportunityChangeItem[]
  radarEvaluations   RadarEvaluation[]
  notificationOutbox NotificationOutbox[]

  @@unique([fromRevisionId, toRevisionId, diffVersion])
  @@index([opportunityId, createdAt])
  @@map("opportunity_change_events")
}

model OpportunityChangeItem {
  id                String                 @id @default(uuid())
  changeEventId     String
  changeEvent       OpportunityChangeEvent @relation(fields: [changeEventId], references: [id], onDelete: Cascade)
  dimension         RadarChangeDimension
  direction         RadarChangeDirection   @default(NEUTRAL)
  severity          RadarChangeSeverity    @default(LOW)
  reasonCode        String
  sanitizedSummary  String
  beforeValue       Json
  afterValue        Json
  numericDelta      Float?
  evidenceSignalIds String[]               @default([])
  createdAt         DateTime               @default(now())

  @@index([changeEventId, dimension])
  @@map("opportunity_change_items")
}

model RadarEvaluation {
  id                       String                  @id @default(uuid())
  watchId                  String
  watch                    SavedOpportunity        @relation(fields: [watchId], references: [id], onDelete: Cascade)
  changeEventId            String
  changeEvent              OpportunityChangeEvent  @relation(fields: [changeEventId], references: [id], onDelete: Cascade)
  founderProfileRevisionId String?
  founderProfileRevision   FounderProfileRevision? @relation(fields: [founderProfileRevisionId], references: [id], onDelete: SetNull)

  previousFounderFit       Int?
  currentFounderFit        Int?
  founderFitDelta          Int?
  previousPersonalizedRank Float?
  currentPersonalizedRank  Float?
  personalizedRankDelta    Float?
  hardBlockersAdded        String[] @default([])
  hardBlockersRemoved      String[] @default([])

  matched            Boolean  @default(false)
  reasonCodes        String[] @default([])
  evaluationVersion  String   @default("1.0.0")
  canonicalInputHash String
  createdAt          DateTime @default(now())

  notificationOutbox NotificationOutbox[]

  @@unique([watchId, changeEventId, evaluationVersion])
  @@index([watchId, matched])
  @@map("radar_evaluations")
}

model NotificationPreference {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailEnabled        Boolean  @default(true)
  instantEnabled      Boolean  @default(true)
  dailyDigestEnabled  Boolean  @default(true)
  weeklyDigestEnabled Boolean  @default(true)
  timezone            String   @default("UTC")
  quietHoursStart     Int? // 0-23
  quietHoursEnd       Int? // 0-23
  unsubscribeToken    String?  @unique
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("notification_preferences")
}

model NotificationOutbox {
  id                String                 @id @default(uuid())
  userId            String
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunityId     String
  opportunity       Opportunity            @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  changeEventId     String
  changeEvent       OpportunityChangeEvent @relation(fields: [changeEventId], references: [id], onDelete: Cascade)
  radarEvaluationId String?
  radarEvaluation   RadarEvaluation?       @relation(fields: [radarEvaluationId], references: [id], onDelete: SetNull)

  notificationType   OutboxNotificationType @default(RADAR_CHANGE_ALERT)
  channel            NotificationChannel    @default(EMAIL)
  scheduledFor       DateTime               @default(now())
  status             OutboxStatus           @default(PENDING)
  deduplicationKey   String                 @unique
  claimToken         String?
  lockedBy           String?
  attemptCount       Int                    @default(0)
  nextAttemptAt      DateTime?
  lockedAt           DateTime?
  lockedUntil        DateTime?
  sentAt             DateTime?
  sanitizedPayload   Json
  sanitizedLastError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries NotificationDelivery[]

  @@index([userId, status, scheduledFor])
  @@index([status, nextAttemptAt])
  @@map("notification_outbox")
}

model NotificationDelivery {
  id                     String             @id @default(uuid())
  outboxId               String
  outbox                 NotificationOutbox @relation(fields: [outboxId], references: [id], onDelete: Cascade)
  attemptNumber          Int                @default(1)
  provider               DeliveryProvider   @default(TEST_MOCK)
  providerIdempotencyKey String
  providerMessageId      String?
  status                 DeliveryStatus     @default(PENDING)
  attemptedAt            DateTime           @default(now())
  deliveredAt            DateTime?
  sanitizedError         String?

  @@unique([outboxId, attemptNumber])
  @@index([outboxId, status])
  @@index([providerIdempotencyKey])
  @@map("notification_deliveries")
}

model NotificationUnsubscribeToken {
  id         String              @id @default(uuid())
  tokenHash  String              @unique
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    String              @default("BUILDWORTH_RADAR_UNSUBSCRIBE_V1")
  channel    NotificationChannel @default(EMAIL)
  keyVersion Int                 @default(2)
  expiresAt  DateTime
  revokedAt  DateTime?
  consumedAt DateTime?
  createdAt  DateTime            @default(now())

  @@index([userId, channel])
  @@index([expiresAt])
  @@map("notification_unsubscribe_tokens")
}

model DigestRun {
  id           String                 @id @default(uuid())
  userId       String
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  digestType   OutboxNotificationType // RADAR_DAILY_DIGEST or RADAR_WEEKLY_DIGEST
  scheduledFor DateTime
  processedAt  DateTime?
  status       String                 @default("PENDING") // PENDING, COMPLETED, SKIPPED
  createdAt    DateTime               @default(now())

  @@unique([userId, digestType, scheduledFor])
  @@index([userId, status])
  @@map("digest_runs")
}

// ====================================================
// PHASE 4D: PREMIUM CONTENT & SECURE EXPORTS
// ====================================================

enum ExportFormat {
  PDF
  CSV
}

enum ExportStatus {
  PENDING
  COMPLETED
  FAILED
  REJECTED
}

model OpportunityExport {
  id                    String              @id @default(uuid())
  requestKey            String // Client-supplied or generated Idempotency / Request Key
  userId                String
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunityId         String
  opportunity           Opportunity         @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  opportunityRevisionId String
  opportunityRevision   OpportunityRevision @relation(fields: [opportunityRevisionId], references: [id], onDelete: Cascade)
  format                ExportFormat
  status                ExportStatus        @default(PENDING)
  quotaPeriodKey        String // Authoritative UTC Period bucket key (e.g. YYYY-MM)
  policyVersion         String              @default("1.0.0")
  entitlementSnapshot   Json
  reservationLedgerId   String?             @unique // Reference to +1 reservation UsageLedger row
  reservationLedger     UsageLedger?        @relation("ExportReservation", fields: [reservationLedgerId], references: [id], onDelete: SetNull)
  consumptionLedgerId   String? // Explicit alias to reservation row upon successful completion
  consumptionLedger     UsageLedger?        @relation("ExportConsumption", fields: [consumptionLedgerId], references: [id], onDelete: SetNull)
  releaseLedgerId       String?             @unique // Reference to -1 compensating UsageLedger row on failed generation
  releaseLedger         UsageLedger?        @relation("ExportRelease", fields: [releaseLedgerId], references: [id], onDelete: SetNull)
  reservationExpiresAt  DateTime? // Expiry timestamp for abandoned PENDING recovery
  requestedAt           DateTime            @default(now())
  completedAt           DateTime?
  failedAt              DateTime?
  rejectedAt            DateTime?
  failureCode           String? // e.g. "PRO_REQUIRED", "QUOTA_EXCEEDED", "GENERATION_ERROR"
  byteSize              Int?
  contentHash           String? // SHA-256 content hash
  createdAt             DateTime            @default(now())

  commercialEvents CommercialEvent[]

  @@unique([userId, requestKey])
  @@index([userId, format, requestedAt])
  @@index([opportunityId, format])
  @@index([quotaPeriodKey])
  @@index([status, reservationExpiresAt])
  @@map("opportunity_exports")
}

// ====================================================
// PHASE 4D: PRIVACY-SAFE COMMERCIAL EVENTS
// ====================================================

enum CommercialEventType {
  PAYWALL_VIEWED
  UPGRADE_CTA_CLICKED
  CHECKOUT_CREATED
  CHECKOUT_CANCELLED
  CHECKOUT_COMPLETED
  ENTITLEMENT_ACTIVATED
  EXPORT_REQUESTED
  EXPORT_COMPLETED
  EXPORT_REJECTED
}

enum CommercialEventSource {
  SERVER_PAYWALL_BOUNDARY
  PRICING_PAGE
  CHECKOUT_SERVICE
  WEBHOOK_PROCESSOR
  EXPORT_SERVICE
  OPPORTUNITY_DOSSIER
}

enum CommercialRetentionClass {
  STANDARD_ANALYTICS
  TRANSACTIONAL_LIFECYCLE
  SECURITY_DIAGNOSTIC
}

enum CommercialPurposeCode {
  PRODUCT_CONVERSION_ANALYTICS
  CONTRACT_AND_BILLING_LIFECYCLE
  SERVICE_DELIVERY_AND_SECURITY
}

enum CommercialLawfulBasis {
  CONSENT
  CONTRACT
  LEGAL_OBLIGATION
  LEGITIMATE_INTEREST
}

enum AnalyticsConsentStatus {
  GRANTED
  WITHDRAWN
}

model AnalyticsConsentHistory {
  id            String                 @id @default(uuid())
  userId        String?
  user          User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  consentIdHash String?                @unique // SHA-256 hash of consentId for anonymous consent
  purpose       CommercialPurposeCode  @default(PRODUCT_CONVERSION_ANALYTICS)
  status        AnalyticsConsentStatus
  policyVersion String                 @default("1.0.0")
  source        String                 @default("CONSENT_BANNER")
  keyVersion    Int                    @default(1)
  expiresAt     DateTime?
  grantedAt     DateTime?
  withdrawnAt   DateTime?
  createdAt     DateTime               @default(now())

  @@index([userId, purpose, createdAt])
  @@index([consentIdHash])
  @@map("analytics_consent_histories")
}

model CommercialEvent {
  id                     String                   @id @default(uuid())
  eventType              CommercialEventType
  deduplicationKey       String                   @unique
  userId                 String?
  user                   User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  opportunityId          String?
  opportunity            Opportunity?             @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  checkoutAttemptId      String?
  checkoutAttempt        BillingCheckoutAttempt?  @relation(fields: [checkoutAttemptId], references: [id], onDelete: SetNull)
  exportId               String?
  export                 OpportunityExport?       @relation(fields: [exportId], references: [id], onDelete: SetNull)
  source                 CommercialEventSource
  purposeCode            CommercialPurposeCode
  lawfulBasis            CommercialLawfulBasis
  metadata               Json
  retentionClass         CommercialRetentionClass @default(STANDARD_ANALYTICS)
  retentionPolicyVersion String                   @default("1.0.0")
  retentionExpiresAt     DateTime
  occurredAt             DateTime                 @default(now())
  createdAt              DateTime                 @default(now())
  anonymizedAt           DateTime?
  restrictedAt           DateTime?
  legalHoldUntil         DateTime?
  legalHoldReasonCode    String?

  @@index([eventType, occurredAt])
  @@index([userId, occurredAt])
  @@index([opportunityId, eventType])
  @@index([retentionClass, occurredAt])
  @@index([retentionExpiresAt])
  @@map("commercial_events")
}

// ====================================================
// PHASE 5: DURABLE STAGING MANUAL INGESTION RUNS
// ====================================================

enum IngestionRunStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model IngestionRun {
  id                String             @id @default(uuid())
  idempotencyKey    String             @unique
  status            IngestionRunStatus @default(PENDING)
  claimToken        String?
  lockedBy          String?
  lockedAt          DateTime?
  lockedUntil       DateTime?
  attemptCount      Int                @default(0)
  startedAt         DateTime?
  completedAt       DateTime?
  failedAt          DateTime?
  failureCode       String?
  totalFetched      Int                @default(0)
  totalDeduplicated Int                @default(0)
  rawSignalsCount   Int                @default(0)
  candidatesCount   Int                @default(0)
  publishedCount    Int                @default(0)
  publishedSlugs    String[]           @default([])
  summary           Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([status, lockedUntil])
  @@index([idempotencyKey])
  @@map("ingestion_runs")
}
