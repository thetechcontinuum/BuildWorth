{
  "name": "@buildworth/database",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "db:generate": "DATABASE_URL=\"${DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/buildworth?schema=public}\" prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node dist/seed.js",
    "lint": "tsc --noEmit",
    "audit:evidence": "node dist/audit-script.js",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "audit:founder-fit": "node scripts/audit-founder-fit.js",
    "audit:projections": "node scripts/audit-projections.js",
    "catalog:entitlements": "node scripts/reconcile-catalog.js",
    "audit:entitlements": "node scripts/audit-entitlements.js",
    "audit:billing": "node scripts/audit-billing.js",
    "test:phase4a": "node scripts/test-phase4a-entitlements.js",
    "test:migration:phase4a": "node scripts/test-zero-rehearsal.js",
    "test:phase4b": "node scripts/test-phase4b-e2e-billing.js",
    "test:migration:phase4b": "node scripts/test-zero-rehearsal.js",
    "test:migration:phase2": "node scripts/test-populated-upgrade.js",
    "test:phase3": "node scripts/test-phase3-auth-isolation.js",
    "test:migration:phase3": "node scripts/test-phase3-populated-upgrade.js"
  },
  "dependencies": {
    "@buildworth/shared": "workspace:*",
    "@prisma/client": "^5.16.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "prisma": "^5.16.1",
    "typescript": "^5.5.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "module": "./dist/index.js"
}
