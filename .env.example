NODE_ENV="development"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/buildworth?schema=public"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"
AUTH_SECRET="dev-secret-key-at-least-16-characters-long"

# AI Provider Configuration — Agnes AI (https://agnes-ai.com)
AI_PROVIDER="agnes"
AGNES_AI_API_KEY="your-agnes-ai-api-key"
AGNES_AI_BASE_URL="https://api.agnes-ai.com/v1"
AGNES_AI_MODEL="agnes-default"
AGNES_AI_EMBEDDING_MODEL="agnes-embed-default"

# Spend Guardrails & Kill Switches
AI_DAILY_SPEND_LIMIT_CENTS=500
AI_MONTHLY_SPEND_LIMIT_CENTS=15000
LOG_LEVEL="info"
